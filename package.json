{
  "name": "applyflow-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "ApplyFlow - Full-Stack MERN Job Application Tracker",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "test": "npm run test:server && npm run test:client",
    "lint:server": "npm --prefix server run lint",
    "lint:client": "npm --prefix client run lint",
    "lint": "npm run lint:server && npm run lint:client"
  }
}
